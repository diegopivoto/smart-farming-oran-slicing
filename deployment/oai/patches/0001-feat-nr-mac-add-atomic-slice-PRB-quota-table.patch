diff --git a/openair2/LAYER2/NR_MAC_gNB/tests/prb_quota_test.c b/openair2/LAYER2/NR_MAC_gNB/tests/prb_quota_test.c
new file mode 100644
index 0000000000..dc3eaddb35
--- /dev/null
+++ b/openair2/LAYER2/NR_MAC_gNB/tests/prb_quota_test.c
@@ -0,0 +1,282 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+#include "../smartfarm_prb_quota.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(cond)                                                    \
+  do {                                                                 \
+    if (!(cond)) {                                                     \
+      fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+      exit(1);                                                         \
+    }                                                                  \
+  } while (0)
+
+static const uint64_t SEC = 1000000000ULL;
+static const uint64_t T0 = 1793646912ULL * 1000000000ULL;
+
+static sf_prb_action_t action(uint64_t id, uint32_t sd, uint16_t rnti, uint16_t prb)
+{
+  sf_prb_action_t a = {
+      .action_id = id,
+      .target = {.sst = 1, .sd = sd, .rnti = rnti},
+      .prb_quota = prb,
+      .ttl_ms = 30000,
+      .issued_at_ns = T0,
+  };
+  memset(a.run_id, 0xab, sizeof(a.run_id));
+  return a;
+}
+
+static sf_prb_target_t ue(uint32_t sd, uint16_t rnti)
+{
+  return (sf_prb_target_t){.sst = 1, .sd = sd, .rnti = rnti};
+}
+
+static void test_default_and_valid_range(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_quota_meta_t meta;
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 0x4601), T0, &meta) == 106);
+  CHECK(!meta.matched);
+
+  const uint16_t valid[] = {24, 52, 78, 106};
+  for (size_t i = 0; i < 4; i++) {
+    sf_prb_action_t a = action(10 + i, 1, 0, valid[i]);
+    sf_quota_outcome_t o = sf_prb_quota_apply(&t, &a, T0);
+    CHECK(o.status == SF_QUOTA_APPLIED);
+    CHECK(!o.duplicate);
+    CHECK(o.requested_prb == valid[i] && o.applied_prb == valid[i]);
+    CHECK(sf_prb_quota_lookup(&t, ue(1, 0x4601), T0 + SEC, &meta) == valid[i]);
+    CHECK(meta.matched && meta.action_id == 10 + i);
+  }
+
+  const uint16_t invalid[] = {0, 23, 25, 107, 275};
+  for (size_t i = 0; i < 5; i++) {
+    sf_prb_action_t a = action(100 + i, 2, 0, invalid[i]);
+    sf_quota_outcome_t o = sf_prb_quota_apply(&t, &a, T0);
+    CHECK(o.status == SF_QUOTA_REJECTED_RANGE);
+    CHECK(sf_prb_quota_lookup(&t, ue(2, 0x4601), T0, NULL) == 106);
+  }
+}
+
+static void test_slices_and_rnti_do_not_leak(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_prb_action_t a1 = action(1, 1, 0, 24);
+  sf_prb_action_t a2 = action(2, 2, 0, 78);
+  sf_prb_action_t a3 = action(3, 1, 0x4602, 52);
+  CHECK(sf_prb_quota_apply(&t, &a1, T0).status == SF_QUOTA_APPLIED);
+  CHECK(sf_prb_quota_apply(&t, &a2, T0).status == SF_QUOTA_APPLIED);
+  CHECK(sf_prb_quota_apply(&t, &a3, T0).status == SF_QUOTA_APPLIED);
+
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 0x4601), T0, NULL) == 24);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 0x4602), T0, NULL) == 52); /* RNTI rule wins */
+  CHECK(sf_prb_quota_lookup(&t, ue(2, 0x4601), T0, NULL) == 78);
+  CHECK(sf_prb_quota_lookup(&t, ue(3, 0x4601), T0, NULL) == 106);
+  sf_prb_target_t other_sst = {.sst = 2, .sd = 1, .rnti = 0x4601};
+  CHECK(sf_prb_quota_lookup(&t, other_sst, T0, NULL) == 106);
+}
+
+static void test_unmapped_ue_counts(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_prb_action_t a = action(1, 1, 0, 24);
+  sf_prb_quota_apply(&t, &a, T0);
+  sf_prb_target_t no_drb = {.sst = 0, .sd = SF_PRB_QUOTA_NO_SD, .rnti = 0x4601};
+  CHECK(sf_prb_quota_lookup(&t, no_drb, T0, NULL) == 106);
+  CHECK(sf_prb_quota_counters(&t).unmapped == 1);
+}
+
+static void test_expiry_returns_default(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_prb_action_t a = action(1, 1, 0, 24);
+  a.ttl_ms = 2000;
+  sf_quota_outcome_t o = sf_prb_quota_apply(&t, &a, T0);
+  CHECK(o.status == SF_QUOTA_APPLIED);
+  CHECK(o.expires_at_ns == T0 + 2 * SEC);
+  sf_quota_meta_t meta;
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0 + SEC, &meta) == 24);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0 + 2 * SEC, &meta) == 106);
+  CHECK(meta.expired && !meta.matched);
+  CHECK(sf_prb_quota_counters(&t).expired == 1);
+
+  sf_prb_rule_snapshot_t rules[SF_PRB_QUOTA_MAX_RULES];
+  uint32_t version = 0;
+  CHECK(sf_prb_quota_snapshot(&t, T0 + 3 * SEC, rules, &version) == 0);
+}
+
+static void test_ttl_and_staleness(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_prb_action_t a = action(1, 1, 0, 24);
+  a.ttl_ms = 0;
+  CHECK(sf_prb_quota_apply(&t, &a, T0).status == SF_QUOTA_REJECTED_TTL);
+  a.action_id = 11;
+  a.ttl_ms = SF_PRB_QUOTA_MAX_TTL_MS + 1;
+  CHECK(sf_prb_quota_apply(&t, &a, T0).status == SF_QUOTA_REJECTED_TTL);
+
+  sf_prb_action_t stale = action(2, 1, 0, 24);
+  stale.ttl_ms = 1000;
+  CHECK(sf_prb_quota_apply(&t, &stale, T0 + 2 * SEC).status == SF_QUOTA_REJECTED_STALE);
+
+  sf_prb_action_t future = action(3, 1, 0, 24);
+  future.issued_at_ns = T0 + 10 * SEC;
+  CHECK(sf_prb_quota_apply(&t, &future, T0).status == SF_QUOTA_REJECTED_STALE);
+
+  sf_prb_action_t no_run = action(4, 1, 0, 24);
+  memset(no_run.run_id, 0, sizeof(no_run.run_id));
+  CHECK(sf_prb_quota_apply(&t, &no_run, T0).status == SF_QUOTA_REJECTED_RUN);
+
+  sf_prb_action_t bad_sd = action(5, 0x1000000, 0, 24);
+  CHECK(sf_prb_quota_apply(&t, &bad_sd, T0).status == SF_QUOTA_REJECTED_TARGET);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0, NULL) == 106);
+}
+
+static void test_duplicate_and_conflict(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_prb_action_t a = action(42, 1, 0, 52);
+  sf_quota_outcome_t first = sf_prb_quota_apply(&t, &a, T0);
+  CHECK(first.status == SF_QUOTA_APPLIED);
+
+  /* a newer action changes the slice; replaying 42 must not reapply 52 */
+  sf_prb_action_t b = action(43, 1, 0, 24);
+  CHECK(sf_prb_quota_apply(&t, &b, T0).status == SF_QUOTA_APPLIED);
+  sf_quota_outcome_t again = sf_prb_quota_apply(&t, &a, T0 + SEC);
+  CHECK(again.duplicate);
+  CHECK(again.status == first.status && again.applied_prb == 52);
+  CHECK(again.rollback_token == first.rollback_token);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0 + SEC, NULL) == 24);
+
+  sf_prb_action_t different = action(42, 1, 0, 78);
+  sf_quota_outcome_t conflict = sf_prb_quota_apply(&t, &different, T0);
+  CHECK(conflict.status == SF_QUOTA_CONFLICT);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0, NULL) == 24);
+}
+
+static void test_rollback(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  sf_prb_action_t a = action(1, 1, 0, 52);
+  sf_quota_outcome_t applied_a = sf_prb_quota_apply(&t, &a, T0);
+  sf_prb_action_t b = action(2, 1, 0, 24);
+  sf_quota_outcome_t applied_b = sf_prb_quota_apply(&t, &b, T0);
+  CHECK(applied_b.previous_prb == 52);
+
+  sf_rollback_t wrong = {.action_id = 90, .target_action_id = 2, .rollback_token = applied_b.rollback_token ^ 1,
+                         .ttl_ms = 30000, .issued_at_ns = T0};
+  memset(wrong.run_id, 0xab, sizeof(wrong.run_id));
+  CHECK(sf_prb_quota_rollback(&t, &wrong, T0).status == SF_QUOTA_ROLLBACK_TOKEN);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0, NULL) == 24);
+
+  sf_rollback_t unknown = wrong;
+  unknown.action_id = 91;
+  unknown.target_action_id = 999;
+  CHECK(sf_prb_quota_rollback(&t, &unknown, T0).status == SF_QUOTA_ROLLBACK_UNKNOWN);
+
+  /* undoing a superseded action is refused: it would clobber the newer rule */
+  sf_rollback_t old = wrong;
+  old.action_id = 92;
+  old.target_action_id = 1;
+  old.rollback_token = applied_a.rollback_token;
+  CHECK(sf_prb_quota_rollback(&t, &old, T0).status == SF_QUOTA_ROLLBACK_SUPERSEDED);
+
+  sf_rollback_t good = wrong;
+  good.action_id = 93;
+  good.rollback_token = applied_b.rollback_token;
+  sf_quota_outcome_t rolled = sf_prb_quota_rollback(&t, &good, T0 + SEC);
+  CHECK(rolled.status == SF_QUOTA_ROLLED_BACK);
+  CHECK(rolled.previous_prb == 24 && rolled.applied_prb == 52);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0 + SEC, NULL) == 52);
+
+  CHECK(sf_prb_quota_rollback(&t, &good, T0 + SEC).duplicate);
+
+  /* rolling back the first rule removes it entirely */
+  sf_rollback_t first = good;
+  first.action_id = 94;
+  first.target_action_id = 1;
+  first.rollback_token = applied_a.rollback_token;
+  CHECK(sf_prb_quota_rollback(&t, &first, T0 + SEC).status == SF_QUOTA_ROLLED_BACK);
+  CHECK(sf_prb_quota_lookup(&t, ue(1, 1), T0 + SEC, NULL) == 106);
+}
+
+static void test_table_full(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  for (uint32_t sd = 1; sd <= SF_PRB_QUOTA_MAX_RULES; sd++) {
+    sf_prb_action_t a = action(sd, sd, 0, 24);
+    CHECK(sf_prb_quota_apply(&t, &a, T0).status == SF_QUOTA_APPLIED);
+  }
+  sf_prb_action_t extra = action(50, 9, 0, 24);
+  CHECK(sf_prb_quota_apply(&t, &extra, T0).status == SF_QUOTA_TABLE_FULL);
+  /* an expired slot is reclaimed */
+  CHECK(sf_prb_quota_apply(&t, &(sf_prb_action_t){0}, T0).status != SF_QUOTA_APPLIED);
+  sf_prb_action_t later = action(51, 9, 0, 24);
+  later.issued_at_ns = T0 + 31 * SEC;
+  CHECK(sf_prb_quota_apply(&t, &later, T0 + 31 * SEC).status == SF_QUOTA_APPLIED);
+}
+
+typedef struct {
+  sf_prb_quota_table_t *table;
+  atomic_bool *stop;
+  uint64_t bad;
+} reader_arg_t;
+
+static void *reader(void *p)
+{
+  reader_arg_t *arg = p;
+  while (!atomic_load(arg->stop)) {
+    uint16_t q = sf_prb_quota_lookup(arg->table, ue(1, 1), T0, NULL);
+    if (!sf_prb_quota_is_valid(q))
+      arg->bad++;
+  }
+  return NULL;
+}
+
+static void test_concurrent_readers_see_valid_quotas(void)
+{
+  sf_prb_quota_table_t t;
+  sf_prb_quota_init(&t, 7);
+  atomic_bool stop = false;
+  reader_arg_t arg = {.table = &t, .stop = &stop};
+  pthread_t th;
+  CHECK(pthread_create(&th, NULL, reader, &arg) == 0);
+  const uint16_t valid[] = {24, 52, 78, 106};
+  for (uint64_t i = 0; i < 20000; i++) {
+    sf_prb_action_t a = action(1000 + i, 1, 0, valid[i % 4]);
+    CHECK(sf_prb_quota_apply(&t, &a, T0).status == SF_QUOTA_APPLIED);
+  }
+  atomic_store(&stop, true);
+  pthread_join(th, NULL);
+  CHECK(arg.bad == 0);
+}
+
+int main(void)
+{
+  test_default_and_valid_range();
+  test_slices_and_rnti_do_not_leak();
+  test_unmapped_ue_counts();
+  test_expiry_returns_default();
+  test_ttl_and_staleness();
+  test_duplicate_and_conflict();
+  test_rollback();
+  test_table_full();
+  test_concurrent_readers_see_valid_quotas();
+  printf("prb_quota_test: all tests passed\n");
+  return 0;
+}
