index 0000000000..5c0692ac0d
--- /dev/null
+++ b/tests/nrdlbench/nr-dlbench-sf-quota-test.sh
@@ -0,0 +1,51 @@
+#!/bin/bash
+# SPDX-License-Identifier: LicenseRef-CSSL-1.0
+#
+# Smart Farming slice PRB quota scenarios on the real DL scheduler.
+# usage: nr-dlbench-sf-quota-test.sh <nr_dlbench> <quota> [retx]
+#   quota: new transmissions must never exceed it; below 106 it must bind
+#   retx:  quota starts after warm-up under BLER, HARQ retx keep their size
+BIN="$1"
+QUOTA="$2"
+MODE="${3:-newtx}"
+
+if [ "${MODE}" = "retx" ]; then
+  ARGS=(-u 1 -R 106 -n 400 -L 0 -B 0.3 -Q "${QUOTA}" -q 100)
+else
+  ARGS=(-u 1 -R 106 -n 300 -L 0 -Q "${QUOTA}")
+fi
+OUT=$("${BIN}" "${ARGS[@]}" 2>&1)
+RET=$?
+echo "${OUT}" | tail -n 20
+if [ ${RET} -ne 0 ]; then
+  echo "FAIL: nr_dlbench exited with code ${RET}"
+  exit 1
+fi
+LINE=$(echo "${OUT}" | grep '^smartfarm_quota ')
+if [ -z "${LINE}" ]; then
+  echo "FAIL: no smartfarm_quota summary"
+  exit 1
+fi
+field() { echo "${LINE}" | tr ' ' '\n' | sed -n "s/^$1=//p"; }
+NEW=$(field new_pdsch)
+MAX_NEW=$(field max_new_rb)
+MAX_RETX=$(field max_retx_rb)
+BYPASS=$(field bypass_retx)
+if [ "${NEW}" -eq 0 ]; then
+  echo "FAIL: no new transmission scheduled under the quota"
+  exit 1
+fi
+if [ "${MAX_NEW}" -gt "${QUOTA}" ]; then
+  echo "FAIL: max_new_rb ${MAX_NEW} exceeds quota ${QUOTA}"
+  exit 1
+fi
+if [ "${MODE}" = "retx" ]; then
+  if [ "${MAX_RETX}" -le "${QUOTA}" ] || [ "${BYPASS}" -eq 0 ]; then
+    echo "FAIL: expected a retransmission larger than quota ${QUOTA} (max_retx_rb=${MAX_RETX} bypass=${BYPASS})"
+    exit 1
+  fi
+elif [ "${QUOTA}" -lt 106 ] && [ "${MAX_NEW}" -ne "${QUOTA}" ]; then
+  echo "FAIL: quota ${QUOTA} never became the binding limit (max_new_rb=${MAX_NEW})"
+  exit 1
+fi
+echo "PASS"
