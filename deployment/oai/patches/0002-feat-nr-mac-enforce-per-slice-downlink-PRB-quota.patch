diff --git a/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch.c b/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch.c
index 7589603ccb..9dac85a199 100644
--- a/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch.c
+++ b/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch.c
@@ -718,6 +718,18 @@ static void nr_dl_schedule(gNB_MAC_INST *mac,
   if (n == 0)
     return;
 
+  /* Step 1b: Smart Farming per-slice PRB quota. A retransmission keeps its
+   * original size; the quota only caps new data in the RB-allocation policy. */
+  const uint64_t quota_now_ns = sf_realtime_ns();
+  FOR_EACH_CANDIDATE(cand, candidates, n) {
+    sf_prb_target_t target = {.sst = cand->nssai.sst, .sd = cand->nssai.sd, .rnti = cand->rnti};
+    sf_quota_meta_t meta;
+    cand->prb_quota = sf_prb_quota_lookup(&mac->sf_prb_quotas, target, quota_now_ns, &meta);
+    cand->prb_quota_action_id = meta.matched ? meta.action_id : 0;
+    if (cand->is_retx && cand->retx_rbSize > cand->prb_quota)
+      sf_prb_quota_count_bypass_retx(&mac->sf_prb_quotas);
+  }
+
   /* Step 2: RI/PMI selection — sets sched_pdsch.nrOfLayers and pm_index per candidate */
   mac->dl_ri_pmi_select(cell, candidates, n);
 
