--- /dev/null
+++ b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/ran_func_sf.c
@@ -0,0 +1,237 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*! \file ran_func_sf.c
+ * \brief Smart Farming per-slice DL PRB quota over the custom SLICE SM.
+ *
+ * Remote input is never asserted on: malformed or out-of-policy requests
+ * produce a REJECTED_* outcome that is returned in the control outcome
+ * diagnostic and published in the next indication.
+ */
+
+#include "ran_func_sf.h"
+#include "smartfarm_sf_codec.h"
+#include "openair2/LAYER2/NR_MAC_gNB/nr_mac_gNB.h"
+#include "openair2/E2AP/flexric/src/util/time_now_us.h"
+
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SF_OUTCOME_RING 8
+#define SF_MAX_UE_REPORTS 16
+#define SF_SLICE_SCHED "SF"
+/* The SLICE SM subscribes at most every 10 ms; report the table at 5 Hz and
+ * right away (next tick) when a new outcome is pending. */
+#define SF_REPORT_PERIOD_NS 200000000ULL
+
+static pthread_mutex_t outcome_lock = PTHREAD_MUTEX_INITIALIZER;
+static char outcome_ring[SF_OUTCOME_RING][SF_CODEC_MAX_LABEL];
+static size_t outcome_next;
+static size_t outcome_len;
+static uint64_t outcome_seq; /* guarded by outcome_lock */
+static uint64_t reported_seq; /* guarded by outcome_lock */
+static uint64_t last_report_ns; /* guarded by outcome_lock */
+
+static sf_prb_quota_table_t *quota_table(void)
+{
+  if (RC.nrmac == NULL || RC.nrmac[0] == NULL)
+    return NULL;
+  return &RC.nrmac[0]->sf_prb_quotas;
+}
+
+static void remember_outcome(const char *label)
+{
+  pthread_mutex_lock(&outcome_lock);
+  snprintf(outcome_ring[outcome_next], SF_CODEC_MAX_LABEL, "%s", label);
+  outcome_next = (outcome_next + 1) % SF_OUTCOME_RING;
+  if (outcome_len < SF_OUTCOME_RING)
+    outcome_len++;
+  outcome_seq++;
+  pthread_mutex_unlock(&outcome_lock);
+}
+
+static bool report_due(uint64_t now_ns)
+{
+  pthread_mutex_lock(&outcome_lock);
+  const bool due = outcome_seq != reported_seq || now_ns - last_report_ns >= SF_REPORT_PERIOD_NS;
+  if (due) {
+    reported_seq = outcome_seq;
+    last_report_ns = now_ns;
+  }
+  pthread_mutex_unlock(&outcome_lock);
+  return due;
+}
+
+static bool is_success(const sf_quota_outcome_t *o)
+{
+  return o->status == SF_QUOTA_APPLIED || o->status == SF_QUOTA_ROLLED_BACK;
+}
+
+static sf_quota_outcome_t handle_request(const char *label, size_t len)
+{
+  sf_request_t req;
+  sf_quota_outcome_t out = {0};
+  sf_prb_quota_table_t *table = quota_table();
+  if (!sf_codec_parse_request(label, len, &req) || table == NULL) {
+    out.status = SF_QUOTA_REJECTED_MALFORMED;
+    out.action_id = req.action_id;
+    printf("[E2 Agent]: SF request rejected (%s)\n", table == NULL ? "MAC not ready" : req.error);
+    return out;
+  }
+  const uint64_t now_ns = sf_realtime_ns();
+  if (req.kind == SF_REQ_PRB_QUOTA)
+    out = sf_prb_quota_apply(table, &req.quota, now_ns);
+  else
+    out = sf_prb_quota_rollback(table, &req.rollback, now_ns);
+  return out;
+}
+
+sm_ag_if_ans_t write_ctrl_sf_sm(void const *data)
+{
+  sm_ag_if_ans_t ans = {.type = CTRL_OUTCOME_SM_AG_IF_ANS_V0};
+  ans.ctrl_out.type = SLICE_AGENT_IF_CTRL_ANS_V0;
+  ans.ctrl_out.slice.ans = SLICE_CTRL_OUT_ERROR;
+
+  char label[SF_CODEC_MAX_LABEL] = {0};
+  const slice_ctrl_req_data_t *req = data;
+  bool all_ok = req != NULL;
+  size_t handled = 0;
+
+  if (req != NULL && req->msg.type == SLICE_CTRL_SM_V0_ADD) {
+    const ul_dl_slice_conf_t *dl = &req->msg.u.add_mod_slice.dl;
+    for (uint32_t i = 0; i < dl->len_slices && dl->slices != NULL; i++) {
+      const fr_slice_t *s = &dl->slices[i];
+      sf_quota_outcome_t out = handle_request(s->label, s->len_label);
+      all_ok = all_ok && is_success(&out);
+      if (sf_codec_format_outcome(label, sizeof(label), &out, sf_realtime_ns()) > 0) {
+        remember_outcome(label);
+        printf("[E2 Agent]: SF %s\n", label);
+      }
+      handled++;
+    }
+  }
+  if (handled == 0) {
+    sf_quota_outcome_t out = {.status = SF_QUOTA_REJECTED_MALFORMED};
+    all_ok = false;
+    if (sf_codec_format_outcome(label, sizeof(label), &out, sf_realtime_ns()) > 0)
+      remember_outcome(label);
+    printf("[E2 Agent]: SF control without an ADD request carrying E2SM-SF labels\n");
+  }
+
+  ans.ctrl_out.slice.ans = all_ok ? SLICE_CTRL_OUT_OK : SLICE_CTRL_OUT_ERROR;
+  const size_t diag_len = strnlen(label, sizeof(label));
+  if (diag_len > 0) {
+    ans.ctrl_out.slice.diagnostic = malloc(diag_len);
+    if (ans.ctrl_out.slice.diagnostic != NULL) {
+      memcpy(ans.ctrl_out.slice.diagnostic, label, diag_len);
+      ans.ctrl_out.slice.len_diag = diag_len;
+    }
+  }
+  return ans;
+}
+
+static bool append_slice(fr_slice_t *slices, uint32_t *n, const char *label, uint16_t prb)
+{
+  const size_t len = strlen(label);
+  fr_slice_t *s = &slices[*n];
+  memset(s, 0, sizeof(*s));
+  s->id = *n;
+  s->label = malloc(len);
+  s->sched = malloc(sizeof(SF_SLICE_SCHED) - 1);
+  if (s->label == NULL || s->sched == NULL) {
+    free(s->label);
+    free(s->sched);
+    return false;
+  }
+  memcpy(s->label, label, len);
+  s->len_label = len;
+  memcpy(s->sched, SF_SLICE_SCHED, sizeof(SF_SLICE_SCHED) - 1);
+  s->len_sched = sizeof(SF_SLICE_SCHED) - 1;
+  /* the plain SLICE encoder only accepts concrete parameter types */
+  s->params.type = SLICE_ALG_SM_V0_STATIC;
+  s->params.u.sta.pos_low = 0;
+  s->params.u.sta.pos_high = prb > 0 ? prb - 1U : 0U;
+  (*n)++;
+  return true;
+}
+
+static nssai_t first_drb_nssai(const NR_UE_sched_ctrl_t *sched_ctrl)
+{
+  nssai_t nssai = {0, SF_PRB_QUOTA_NO_SD};
+  for (size_t j = 0; j < seq_arr_size(&sched_ctrl->lc_config); j++) {
+    const nr_lc_config_t *c = seq_arr_at(&sched_ctrl->lc_config, j);
+    if (c->lcid >= 4)
+      return c->nssai;
+  }
+  return nssai;
+}
+
+bool read_sf_sm(void *data)
+{
+  assert(data != NULL);
+  slice_ind_data_t *ind = (slice_ind_data_t *)data;
+  sf_prb_quota_table_t *table = quota_table();
+  if (table == NULL || !report_due(sf_realtime_ns()))
+    return false;
+
+  const uint32_t capacity = 1 + SF_PRB_QUOTA_MAX_RULES + SF_OUTCOME_RING + SF_MAX_UE_REPORTS;
+  fr_slice_t *slices = calloc(capacity, sizeof(*slices));
+  if (slices == NULL)
+    return false;
+  uint32_t n = 0;
+  char label[SF_CODEC_MAX_LABEL];
+  const uint64_t now_ns = sf_realtime_ns();
+
+  sf_prb_rule_snapshot_t rules[SF_PRB_QUOTA_MAX_RULES];
+  uint32_t version = 0;
+  const int n_rules = sf_prb_quota_snapshot(table, now_ns, rules, &version);
+  sf_quota_counters_snapshot_t counters = sf_prb_quota_counters(table);
+  if (sf_codec_format_counters(label, sizeof(label), &counters, version) > 0)
+    append_slice(slices, &n, label, SF_PRB_QUOTA_DEFAULT);
+  for (int i = 0; i < n_rules; i++)
+    if (sf_codec_format_rule(label, sizeof(label), &rules[i], version) > 0)
+      append_slice(slices, &n, label, rules[i].prb_quota);
+
+  pthread_mutex_lock(&outcome_lock);
+  for (size_t i = 0; i < outcome_len; i++) {
+    size_t idx = (outcome_next + SF_OUTCOME_RING - outcome_len + i) % SF_OUTCOME_RING;
+    append_slice(slices, &n, outcome_ring[idx], 0);
+  }
+  pthread_mutex_unlock(&outcome_lock);
+
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  uint32_t ue_reports = 0;
+  UE_iterator (mac->UE_info.connected_ue_list, UE) {
+    if (ue_reports >= SF_MAX_UE_REPORTS)
+      break;
+    nssai_t nssai = first_drb_nssai(&UE->UE_sched_ctrl);
+    sf_prb_target_t target = {.sst = nssai.sst, .sd = nssai.sd, .rnti = UE->rnti};
+    sf_quota_meta_t meta;
+    uint16_t prb = sf_prb_quota_peek(table, target, now_ns, &meta);
+    if (sf_codec_format_ue(label, sizeof(label), UE->rnti, nssai.sst, nssai.sd, prb, meta.matched ? meta.action_id : 0) > 0
+        && append_slice(slices, &n, label, prb))
+      ue_reports++;
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+
+  ind->msg.slice_conf.dl.slices = slices;
+  ind->msg.slice_conf.dl.len_slices = n;
+  ind->msg.slice_conf.dl.sched_name = malloc(sizeof(SF_SLICE_SCHED) - 1);
+  if (ind->msg.slice_conf.dl.sched_name != NULL) {
+    memcpy(ind->msg.slice_conf.dl.sched_name, SF_SLICE_SCHED, sizeof(SF_SLICE_SCHED) - 1);
+    ind->msg.slice_conf.dl.len_sched_name = sizeof(SF_SLICE_SCHED) - 1;
+  }
+  ind->msg.tstamp = time_now_us();
+  return true;
+}
+
+void read_sf_setup_sm(void *data)
+{
+  /* The SLICE SM agent fills its own RAN Function Definition. */
+  (void)data;
+}
