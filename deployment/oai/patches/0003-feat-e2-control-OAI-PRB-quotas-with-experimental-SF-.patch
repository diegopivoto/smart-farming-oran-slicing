+
+/*! \file ran_func_sf.h
+ * \brief Smart Farming "E2SM-SF/0.1" handlers carried by FlexRIC's custom SLICE SM.
+ *
+ * Control: SLICE_CTRL_SM_V0_ADD whose DL slice labels hold E2SM-SF requests.
+ * Indication: DL slice labels report the effective quota table, the latest
+ * outcomes, per-UE quota readback and scheduler counters.
+ */
+
+#ifndef RAN_FUNC_SM_SF_READ_WRITE_AGENT_H
+#define RAN_FUNC_SM_SF_READ_WRITE_AGENT_H
+
+#include "openair2/E2AP/flexric/src/agent/../sm/sm_io.h"
+
+bool read_sf_sm(void *data);
+
+void read_sf_setup_sm(void *data);
+
+sm_ag_if_ans_t write_ctrl_sf_sm(void const *data);
+
+#endif
diff --git a/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_codec.c b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_codec.c
new file mode 100644
index 0000000000..27887dbb80
--- /dev/null
+++ b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_codec.c
@@ -0,0 +1,329 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*! \file smartfarm_sf_codec.c
+ * \brief Text codec of the experimental "E2SM-SF/0.1" profile (see header).
+ */
+
+#include "smartfarm_sf_codec.h"
+
+#include <inttypes.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef enum {
+  K_ACTION_ID,
+  K_RUN_ID,
+  K_SST,
+  K_SD,
+  K_RNTI,
+  K_PRB,
+  K_TTL_MS,
+  K_ISSUED_AT_NS,
+  K_TARGET_ACTION_ID,
+  K_TOKEN,
+  K_END
+} sf_key_t;
+
+static const char *key_names[K_END] = {
+    [K_ACTION_ID] = "action_id",
+    [K_RUN_ID] = "run_id",
+    [K_SST] = "sst",
+    [K_SD] = "sd",
+    [K_RNTI] = "rnti",
+    [K_PRB] = "prb",
+    [K_TTL_MS] = "ttl_ms",
+    [K_ISSUED_AT_NS] = "issued_at_ns",
+    [K_TARGET_ACTION_ID] = "target_action_id",
+    [K_TOKEN] = "token",
+};
+
+#define BIT(k) (1U << (k))
+static const uint32_t quota_keys =
+    BIT(K_ACTION_ID) | BIT(K_RUN_ID) | BIT(K_SST) | BIT(K_SD) | BIT(K_RNTI) | BIT(K_PRB) | BIT(K_TTL_MS) | BIT(K_ISSUED_AT_NS);
+static const uint32_t rollback_keys =
+    BIT(K_ACTION_ID) | BIT(K_RUN_ID) | BIT(K_TARGET_ACTION_ID) | BIT(K_TOKEN) | BIT(K_TTL_MS) | BIT(K_ISSUED_AT_NS);
+
+static bool parse_dec(const char *s, uint64_t max, uint64_t *out)
+{
+  if (*s == '\0')
+    return false;
+  uint64_t v = 0;
+  for (; *s != '\0'; s++) {
+    if (*s < '0' || *s > '9')
+      return false;
+    uint64_t d = (uint64_t)(*s - '0');
+    if (v > (max - d) / 10)
+      return false;
+    v = v * 10 + d;
+  }
+  *out = v;
+  return true;
+}
+
+static int hex_digit(char c)
+{
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  return -1;
+}
+
+/* Exactly `digits` hex characters (<= 16) into a 64-bit value. */
+static bool parse_hex_fixed(const char *s, size_t digits, uint64_t *out)
+{
+  if (strlen(s) != digits)
+    return false;
+  uint64_t v = 0;
+  for (size_t i = 0; i < digits; i++) {
+    int d = hex_digit(s[i]);
+    if (d < 0)
+      return false;
+    v = (v << 4) | (uint64_t)d;
+  }
+  *out = v;
+  return true;
+}
+
+static bool parse_run_id(const char *s, uint8_t run_id[SF_PRB_QUOTA_RUN_ID_LEN])
+{
+  if (strlen(s) != 2 * SF_PRB_QUOTA_RUN_ID_LEN)
+    return false;
+  for (int i = 0; i < SF_PRB_QUOTA_RUN_ID_LEN; i++) {
+    int hi = hex_digit(s[2 * i]);
+    int lo = hex_digit(s[2 * i + 1]);
+    if (hi < 0 || lo < 0)
+      return false;
+    run_id[i] = (uint8_t)((hi << 4) | lo);
+  }
+  return true;
+}
+
+static bool fail(sf_request_t *out, const char *fmt, ...)
+{
+  va_list ap;
+  va_start(ap, fmt);
+  vsnprintf(out->error, sizeof(out->error), fmt, ap);
+  va_end(ap);
+  out->kind = SF_REQ_INVALID;
+  return false;
+}
+
+static bool assign(sf_request_t *out, sf_request_kind_t kind, sf_key_t key, const char *value)
+{
+  uint64_t v = 0;
+  sf_prb_action_t *q = &out->quota;
+  sf_rollback_t *r = &out->rollback;
+  switch (key) {
+    case K_ACTION_ID:
+      if (!parse_dec(value, UINT64_MAX, &v))
+        return false;
+      out->action_id = v;
+      if (kind == SF_REQ_PRB_QUOTA)
+        q->action_id = v;
+      else
+        r->action_id = v;
+      return true;
+    case K_RUN_ID:
+      return parse_run_id(value, kind == SF_REQ_PRB_QUOTA ? q->run_id : r->run_id);
+    case K_SST:
+      if (!parse_dec(value, UINT8_MAX, &v))
+        return false;
+      q->target.sst = (uint8_t)v;
+      return true;
+    case K_SD:
+      if (!parse_hex_fixed(value, 6, &v))
+        return false;
+      q->target.sd = (uint32_t)v;
+      return true;
+    case K_RNTI:
+      if (!parse_dec(value, UINT16_MAX, &v))
+        return false;
+      q->target.rnti = (uint16_t)v;
+      return true;
+    case K_PRB:
+      if (!parse_dec(value, UINT16_MAX, &v))
+        return false;
+      q->prb_quota = (uint16_t)v;
+      return true;
+    case K_TTL_MS:
+      if (!parse_dec(value, UINT32_MAX, &v))
+        return false;
+      if (kind == SF_REQ_PRB_QUOTA)
+        q->ttl_ms = (uint32_t)v;
+      else
+        r->ttl_ms = (uint32_t)v;
+      return true;
+    case K_ISSUED_AT_NS:
+      if (!parse_dec(value, UINT64_MAX, &v))
+        return false;
+      if (kind == SF_REQ_PRB_QUOTA)
+        q->issued_at_ns = v;
+      else
+        r->issued_at_ns = v;
+      return true;
+    case K_TARGET_ACTION_ID:
+      if (!parse_dec(value, UINT64_MAX, &v))
+        return false;
+      r->target_action_id = v;
+      return true;
+    case K_TOKEN:
+      if (!parse_hex_fixed(value, 16, &v))
+        return false;
+      r->rollback_token = v;
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool sf_codec_parse_request(const char *text, size_t len, sf_request_t *out)
+{
+  memset(out, 0, sizeof(*out));
+  if (text == NULL || len == 0)
+    return fail(out, "empty request");
+  size_t n = strnlen(text, len);
+  if (n >= SF_CODEC_MAX_LABEL)
+    return fail(out, "request longer than %d bytes", SF_CODEC_MAX_LABEL - 1);
+
+  char buf[SF_CODEC_MAX_LABEL];
+  memcpy(buf, text, n);
+  buf[n] = '\0';
+
+  sf_request_kind_t kind = SF_REQ_INVALID;
+  uint32_t seen = 0;
+  int index = 0;
+  char *save = NULL;
+  for (char *pair = strtok_r(buf, ";", &save); pair != NULL; pair = strtok_r(NULL, ";", &save), index++) {
+    char *eq = strchr(pair, '=');
+    if (eq == NULL)
+      return fail(out, "pair without '=': %.32s", pair);
+    *eq = '\0';
+    const char *key = pair;
+    const char *value = eq + 1;
+
+    if (index == 0) {
+      if (strcmp(key, "sf") != 0 || strcmp(value, SF_CODEC_VERSION) != 0)
+        return fail(out, "first pair must be sf=" SF_CODEC_VERSION);
+      continue;
+    }
+    if (index == 1) {
+      if (strcmp(key, "op") != 0)
+        return fail(out, "second pair must be op");
+      if (strcmp(value, "prb_quota") == 0)
+        kind = SF_REQ_PRB_QUOTA;
+      else if (strcmp(value, "rollback") == 0)
+        kind = SF_REQ_ROLLBACK;
+      else
+        return fail(out, "unknown op %.32s", value);
+      continue;
+    }
+
+    const uint32_t allowed = kind == SF_REQ_PRB_QUOTA ? quota_keys : rollback_keys;
+    sf_key_t k = K_END;
+    for (int i = 0; i < K_END; i++)
+      if (strcmp(key, key_names[i]) == 0)
+        k = (sf_key_t)i;
+    if (k == K_END || !(allowed & BIT(k)))
+      return fail(out, "unexpected key %.32s", key);
+    if (seen & BIT(k))
+      return fail(out, "duplicate key %s", key_names[k]);
+    if (!assign(out, kind, k, value))
+      return fail(out, "invalid value for %s", key_names[k]);
+    seen |= BIT(k);
+  }
+
+  if (kind == SF_REQ_INVALID)
+    return fail(out, "missing op");
+  const uint32_t required = kind == SF_REQ_PRB_QUOTA ? quota_keys : rollback_keys;
+  if ((seen & required) != required) {
+    for (int i = 0; i < K_END; i++)
+      if ((required & BIT(i)) && !(seen & BIT(i)))
+        return fail(out, "missing key %s", key_names[i]);
+  }
+  out->kind = kind;
+  return true;
+}
+
+static int finish(char *buf, size_t cap, int written)
+{
+  if (written < 0 || (size_t)written >= cap) {
+    if (cap > 0)
+      buf[0] = '\0';
+    return -1;
+  }
+  return written;
+}
+
+int sf_codec_format_outcome(char *buf, size_t cap, const sf_quota_outcome_t *o, uint64_t at_ns)
+{
+  int w = snprintf(buf,
+                   cap,
+                   "sf=" SF_CODEC_VERSION ";kind=outcome;action_id=%" PRIu64 ";status=%s;dup=%d;sst=%u;sd=%06" PRIx32
+                   ";rnti=%u;requested=%u;applied=%u;previous=%u;token=%016" PRIx64 ";expires_at_ns=%" PRIu64
+                   ";version=%u;at_ns=%" PRIu64,
+                   o->action_id,
+                   sf_quota_status_name(o->status),
+                   o->duplicate ? 1 : 0,
+                   o->target.sst,
+                   o->target.sd,
+                   o->target.rnti,
+                   o->requested_prb,
+                   o->applied_prb,
+                   o->previous_prb,
+                   o->rollback_token,
+                   o->expires_at_ns,
+                   o->table_version,
+                   at_ns);
+  return finish(buf, cap, w);
+}
+
+int sf_codec_format_rule(char *buf, size_t cap, const sf_prb_rule_snapshot_t *r, uint32_t version)
+{
+  int w = snprintf(buf,
+                   cap,
+                   "sf=" SF_CODEC_VERSION ";kind=rule;sst=%u;sd=%06" PRIx32 ";rnti=%u;prb=%u;action_id=%" PRIu64
+                   ";expires_at_ns=%" PRIu64 ";version=%u",
+                   r->target.sst,
+                   r->target.sd,
+                   r->target.rnti,
+                   r->prb_quota,
+                   r->action_id,
+                   r->expires_at_ns,
+                   version);
+  return finish(buf, cap, w);
+}
+
+int sf_codec_format_counters(char *buf, size_t cap, const sf_quota_counters_snapshot_t *c, uint32_t version)
+{
+  int w = snprintf(buf,
+                   cap,
+                   "sf=" SF_CODEC_VERSION ";kind=counters;lookups=%" PRIu64 ";unmapped=%" PRIu64 ";expired=%" PRIu64
+                   ";fallback=%" PRIu64 ";capped=%" PRIu64 ";bypass_retx=%" PRIu64 ";version=%u",
+                   c->lookups,
+                   c->unmapped,
+                   c->expired,
+                   c->fallback,
+                   c->capped_newtx,
+                   c->bypass_retx,
+                   version);
+  return finish(buf, cap, w);
+}
+
+int sf_codec_format_ue(char *buf, size_t cap, uint16_t rnti, uint8_t sst, uint32_t sd, uint16_t prb_quota, uint64_t action_id)
+{
+  int w = snprintf(buf,
+                   cap,
+                   "sf=" SF_CODEC_VERSION ";kind=ue;rnti=%u;sst=%u;sd=%06" PRIx32 ";prb=%u;action_id=%" PRIu64,
+                   rnti,
+                   sst,
+                   sd,
+                   prb_quota,
+                   action_id);
+  return finish(buf, cap, w);
+}
diff --git a/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_codec.h b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_codec.h
new file mode 100644
index 0000000000..dbed298223
--- /dev/null
+++ b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_codec.h
@@ -0,0 +1,57 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*! \file smartfarm_sf_codec.h
+ * \brief Text codec of the experimental Smart Farming profile "E2SM-SF/0.1".
+ *
+ * The profile rides inside the label of FlexRIC's custom SLICE service model:
+ * it is *not* O-RAN E2SM-RC nor a standardized slicing SM. A message is a
+ * sequence of "key=value" pairs separated by ';' whose first pair is
+ * "sf=0.1". Requests (xApp -> gNB) use "op=prb_quota" or "op=rollback";
+ * readback labels (gNB -> xApp) use "kind=rule|outcome|counters|ue".
+ * The full grammar is documented in smart-farming-oran/schemas/e2sm-sf-v0.1.md.
+ */
+
+#ifndef SMARTFARM_SF_CODEC_H
+#define SMARTFARM_SF_CODEC_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "openair2/LAYER2/NR_MAC_gNB/smartfarm_prb_quota.h"
+
+#define SF_CODEC_VERSION "0.1"
+#define SF_CODEC_MAX_LABEL 512
+
+typedef enum {
+  SF_REQ_INVALID = 0,
+  SF_REQ_PRB_QUOTA,
+  SF_REQ_ROLLBACK,
+} sf_request_kind_t;
+
+typedef struct {
+  sf_request_kind_t kind;
+  uint64_t action_id; /* best effort, also filled for invalid requests when decodable */
+  sf_prb_action_t quota;
+  sf_rollback_t rollback;
+  char error[96];
+} sf_request_t;
+
+/* Decodes a request label; returns false (kind = SF_REQ_INVALID, error set) on any defect. */
+bool sf_codec_parse_request(const char *text, size_t len, sf_request_t *out);
+
+/* Formatters return the number of characters written (excluding NUL) or -1 when truncated. */
+int sf_codec_format_outcome(char *buf, size_t cap, const sf_quota_outcome_t *outcome, uint64_t at_ns);
+int sf_codec_format_rule(char *buf, size_t cap, const sf_prb_rule_snapshot_t *rule, uint32_t version);
+int sf_codec_format_counters(char *buf, size_t cap, const sf_quota_counters_snapshot_t *counters, uint32_t version);
+int sf_codec_format_ue(char *buf,
+                       size_t cap,
+                       uint16_t rnti,
+                       uint8_t sst,
+                       uint32_t sd,
+                       uint16_t prb_quota,
+                       uint64_t action_id);
+
+#endif
diff --git a/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/tests/sf_codec_test.c b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/tests/sf_codec_test.c
new file mode 100644
index 0000000000..1efb78124c
--- /dev/null
+++ b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/tests/sf_codec_test.c
@@ -0,0 +1,139 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+#include "../smartfarm_sf_codec.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(cond)                                                    \
+  do {                                                                 \
+    if (!(cond)) {                                                     \
+      fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+      exit(1);                                                         \
+    }                                                                  \
+  } while (0)
+
+#define RUN "0123456789abcdef0123456789abcdef"
+
+static bool parse(const char *text, sf_request_t *req)
+{
+  return sf_codec_parse_request(text, strlen(text), req);
+}
+
+static void test_quota_request(void)
+{
+  sf_request_t r;
+  CHECK(parse("sf=0.1;op=prb_quota;action_id=18446744073709551615;run_id=" RUN
+              ";sst=1;sd=000002;rnti=17921;prb=52;ttl_ms=30000;issued_at_ns=1793646912000000000",
+              &r));
+  CHECK(r.kind == SF_REQ_PRB_QUOTA);
+  CHECK(r.quota.action_id == UINT64_MAX && r.action_id == UINT64_MAX);
+  CHECK(r.quota.run_id[0] == 0x01 && r.quota.run_id[15] == 0xef);
+  CHECK(r.quota.target.sst == 1 && r.quota.target.sd == 2 && r.quota.target.rnti == 17921);
+  CHECK(r.quota.prb_quota == 52 && r.quota.ttl_ms == 30000);
+  CHECK(r.quota.issued_at_ns == 1793646912000000000ULL);
+}
+
+static void test_rollback_request(void)
+{
+  sf_request_t r;
+  CHECK(parse("sf=0.1;op=rollback;action_id=9;run_id=" RUN
+              ";target_action_id=8;token=00000000deadbeef;ttl_ms=5000;issued_at_ns=10",
+              &r));
+  CHECK(r.kind == SF_REQ_ROLLBACK);
+  CHECK(r.rollback.action_id == 9 && r.rollback.target_action_id == 8);
+  CHECK(r.rollback.rollback_token == 0xdeadbeefULL);
+  CHECK(r.rollback.ttl_ms == 5000 && r.rollback.issued_at_ns == 10);
+}
+
+static void test_rejections(void)
+{
+  const char *bad[] = {
+      "",
+      "op=prb_quota;sf=0.1", /* version must come first */
+      "sf=0.2;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=steal;action_id=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=52;ttl_ms=1", /* missing */
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1;x=1",
+      "sf=0.1;op=prb_quota;action_id=1;action_id=2;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=-1;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=xyz;sst=1;sd=000001;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=256;sd=000001;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=1000000;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=00000g;rnti=0;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=000001;rnti=65536;prb=52;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=52x;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=prb_quota;action_id=1;run_id=" RUN ";sst=1;sd=000001;rnti=0;prb=;ttl_ms=1;issued_at_ns=1",
+      "sf=0.1;op=rollback;action_id=9;run_id=" RUN ";target_action_id=8;token=xyz;ttl_ms=5000;issued_at_ns=10",
+  };
+  for (size_t i = 0; i < sizeof(bad) / sizeof(bad[0]); i++) {
+    sf_request_t r;
+    if (parse(bad[i], &r)) {
+      fprintf(stderr, "accepted malformed request #%zu: %s\n", i, bad[i]);
+      exit(1);
+    }
+    CHECK(r.kind == SF_REQ_INVALID);
+    CHECK(r.error[0] != '\0');
+  }
+
+  /* not NUL terminated within len and oversize */
+  char big[SF_CODEC_MAX_LABEL + 10];
+  memset(big, 'a', sizeof(big));
+  sf_request_t r;
+  CHECK(!sf_codec_parse_request(big, sizeof(big), &r));
+
+  /* action id is still reported for a decodable-but-invalid request */
+  CHECK(!parse("sf=0.1;op=prb_quota;action_id=77;run_id=" RUN ";sst=1", &r));
+  CHECK(r.action_id == 77);
+}
+
+static void test_formatters(void)
+{
+  char buf[SF_CODEC_MAX_LABEL];
+  sf_quota_outcome_t o = {
+      .status = SF_QUOTA_APPLIED,
+      .duplicate = true,
+      .action_id = 5,
+      .target = {.sst = 1, .sd = 3, .rnti = 0},
+      .requested_prb = 24,
+      .applied_prb = 24,
+      .previous_prb = 106,
+      .rollback_token = 0xabcdefULL,
+      .expires_at_ns = 99,
+      .table_version = 4,
+  };
+  CHECK(sf_codec_format_outcome(buf, sizeof(buf), &o, 1234) > 0);
+  CHECK(strcmp(buf,
+               "sf=0.1;kind=outcome;action_id=5;status=APPLIED;dup=1;sst=1;sd=000003;rnti=0;requested=24;"
+               "applied=24;previous=106;token=0000000000abcdef;expires_at_ns=99;version=4;at_ns=1234")
+        == 0);
+
+  sf_prb_rule_snapshot_t rule = {.target = {.sst = 1, .sd = 1, .rnti = 0}, .prb_quota = 78, .expires_at_ns = 7, .action_id = 3};
+  CHECK(sf_codec_format_rule(buf, sizeof(buf), &rule, 2) > 0);
+  CHECK(strcmp(buf, "sf=0.1;kind=rule;sst=1;sd=000001;rnti=0;prb=78;action_id=3;expires_at_ns=7;version=2") == 0);
+
+  sf_quota_counters_snapshot_t c = {.lookups = 1, .unmapped = 2, .expired = 3, .fallback = 4, .capped_newtx = 5, .bypass_retx = 6};
+  CHECK(sf_codec_format_counters(buf, sizeof(buf), &c, 9) > 0);
+  CHECK(strcmp(buf,
+               "sf=0.1;kind=counters;lookups=1;unmapped=2;expired=3;fallback=4;capped=5;bypass_retx=6;version=9")
+        == 0);
+
+  CHECK(sf_codec_format_ue(buf, sizeof(buf), 0x4601, 1, 1, 52, 3) > 0);
+  CHECK(strcmp(buf, "sf=0.1;kind=ue;rnti=17921;sst=1;sd=000001;prb=52;action_id=3") == 0);
+
+  char tiny[8];
+  CHECK(sf_codec_format_ue(tiny, sizeof(tiny), 0x4601, 1, 1, 52, 3) == -1);
+}
+
+int main(void)
+{
+  test_quota_request();
+  test_rollback_request();
+  test_rejections();
+  test_formatters();
+  printf("sf_codec_test: all tests passed\n");
+  return 0;
+}
