index 0000000000..83deaa759b
--- /dev/null
+++ b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_readback.c
@@ -0,0 +1,79 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*! \file smartfarm_sf_readback.c
+ * \brief SLICE indication packing under the FlexRIC RIC rendering budget.
+ */
+
+#include "smartfarm_sf_readback.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+static uint32_t pos_high_of(uint16_t prb)
+{
+  return prb > 0 ? prb - 1U : 0U;
+}
+
+static char *dup_bytes(const char *src, size_t len)
+{
+  char *dst = malloc(len);
+  if (dst != NULL)
+    memcpy(dst, src, len);
+  return dst;
+}
+
+uint32_t sf_readback_pack(slice_ind_msg_t *msg,
+                          const sf_readback_item_t *items,
+                          size_t n_items,
+                          int64_t tstamp_us,
+                          size_t budget)
+{
+  /* choose first, allocate after: the header length depends on the final count */
+  size_t chosen[SF_READBACK_MAX_SLICES];
+  uint32_t n = 0;
+  size_t body = 0;
+  size_t sql = 0; /* estimated SQL bytes of the rows already chosen */
+  for (size_t i = 0; i < n_items && n < SF_READBACK_MAX_SLICES; i++) {
+    const size_t len = sf_codec_ric_slice_len(n, n, items[i].label, SF_READBACK_SCHED, pos_high_of(items[i].prb));
+    if (sf_codec_ric_header_len(tstamp_us, n + 1) + body + len > budget || sql > SF_READBACK_SQL_BUDGET)
+      continue;
+    chosen[n++] = i;
+    body += len;
+    sql += strlen(items[i].label) + SF_READBACK_SQL_ROW_OVERHEAD;
+  }
+
+  ul_dl_slice_conf_t *dl = &msg->slice_conf.dl;
+  dl->sched_name = dup_bytes(SF_READBACK_SCHED, sizeof(SF_READBACK_SCHED) - 1);
+  dl->len_sched_name = dl->sched_name != NULL ? sizeof(SF_READBACK_SCHED) - 1 : 0;
+  dl->slices = n > 0 ? calloc(n, sizeof(*dl->slices)) : NULL;
+  if (n > 0 && dl->slices == NULL)
+    return 0;
+
+  uint32_t written = 0;
+  for (uint32_t k = 0; k < n; k++) {
+    const sf_readback_item_t *item = &items[chosen[k]];
+    fr_slice_t *s = &dl->slices[written];
+    const size_t len = strlen(item->label);
+    s->label = dup_bytes(item->label, len);
+    s->sched = dup_bytes(SF_READBACK_SCHED, sizeof(SF_READBACK_SCHED) - 1);
+    if (s->label == NULL || s->sched == NULL) {
+      free(s->label);
+      free(s->sched);
+      memset(s, 0, sizeof(*s));
+      continue;
+    }
+    s->id = written;
+    s->len_label = len;
+    s->len_sched = sizeof(SF_READBACK_SCHED) - 1;
+    /* the plain SLICE encoder only accepts concrete parameter types */
+    s->params.type = SLICE_ALG_SM_V0_STATIC;
+    s->params.u.sta.pos_low = 0;
+    s->params.u.sta.pos_high = pos_high_of(item->prb);
+    written++;
+  }
+  dl->len_slices = written;
+  msg->tstamp = tstamp_us;
+  return written;
+}
diff --git a/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_readback.h b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_readback.h
new file mode 100644
index 0000000000..f0ec1236a2
--- /dev/null
+++ b/openair2/E2AP/RAN_FUNCTION/CUSTOMIZED/smartfarm_sf_readback.h
@@ -0,0 +1,48 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*! \file smartfarm_sf_readback.h
+ * \brief Packs E2SM-SF readback labels into a SLICE indication within the RIC rendering budget.
+ */
+
+#ifndef SMARTFARM_SF_READBACK_H
+#define SMARTFARM_SF_READBACK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "smartfarm_sf_codec.h"
+#include "openair2/E2AP/flexric/src/sm/slice_sm/ie/slice_data_ie.h"
+
+#define SF_READBACK_SCHED "SF"
+/*
+ * The FlexRIC xApp SDK stores each SLICE indication in SQLite through a
+ * 4096-byte buffer and asserts >= 1024 free bytes before every slice row
+ * (xApp/db/sqlite3/sqlite3_wrapper.c). Each row is conservatively estimated
+ * as label length + SF_READBACK_SQL_ROW_OVERHEAD, and the rows written before
+ * the last one must stay within SF_READBACK_SQL_BUDGET.
+ */
+#define SF_READBACK_MAX_SLICES 10U
+#define SF_READBACK_SQL_ROW_OVERHEAD 200U
+#define SF_READBACK_SQL_BUDGET 3000U
+
+typedef struct {
+  char label[SF_CODEC_MAX_LABEL];
+  uint16_t prb; /* rendered as STATIC pos_high = prb - 1 (0 when prb is 0) */
+} sf_readback_item_t;
+
+/*
+ * Fills msg->slice_conf.dl with the longest prefix-compatible selection of
+ * `items` (given in priority order; an item that does not fit is skipped and
+ * later, smaller items may still be taken) whose FlexRIC rendering stays
+ * within `budget` bytes. Returns the number of slices written; the caller
+ * owns msg and frees it with free_slice_ind_msg().
+ */
+uint32_t sf_readback_pack(slice_ind_msg_t *msg,
+                          const sf_readback_item_t *items,
+                          size_t n_items,
+                          int64_t tstamp_us,
+                          size_t budget);
+
+#endif
