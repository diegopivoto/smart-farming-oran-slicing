+ */
+
+/* Regression for the near-RT RIC crash of 2026-11-02: the readback must always
+ * render within FlexRIC's 2048-byte to_string_slice() buffer. The real
+ * FlexRIC renderer is linked in, so ASan flags any overflow. */
+
+#include "../smartfarm_sf_readback.h"
+#include "openair2/E2AP/flexric/src/ric/iApps/string_parser.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(cond)                                                    \
+  do {                                                                 \
+    if (!(cond)) {                                                     \
+      fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+      exit(1);                                                         \
+    }                                                                  \
+  } while (0)
+
+static const int64_t TSTAMP = 1793646912123456LL;
+
+/* worst-case widths: every numeric field at its maximum */
+static size_t worst_case_items(sf_readback_item_t *items)
+{
+  size_t n = 0;
+  sf_quota_outcome_t o = {.status = SF_QUOTA_ROLLBACK_SUPERSEDED, .duplicate = true, .action_id = UINT64_MAX,
+                          .target = {.sst = 255, .sd = 0xffffff, .rnti = 65535}, .requested_prb = 65535,
+                          .applied_prb = 106, .previous_prb = 106, .rollback_token = UINT64_MAX,
+                          .expires_at_ns = UINT64_MAX, .table_version = UINT32_MAX};
+  for (int i = 0; i < 8; i++, n++) {
+    sf_codec_format_outcome(items[n].label, sizeof(items[n].label), &o, UINT64_MAX);
+    items[n].prb = 0;
+  }
+  for (int i = 0; i < SF_PRB_QUOTA_MAX_RULES; i++, n++) {
+    sf_prb_rule_snapshot_t r = {.target = {.sst = 255, .sd = 0xffffff, .rnti = 65535}, .prb_quota = 106,
+                                .expires_at_ns = UINT64_MAX, .action_id = UINT64_MAX};
+    sf_codec_format_rule(items[n].label, sizeof(items[n].label), &r, UINT32_MAX);
+    items[n].prb = 106;
+  }
+  for (int i = 0; i < 16; i++, n++) {
+    sf_codec_format_ue(items[n].label, sizeof(items[n].label), 65535, 255, 0xffffff, 106, UINT64_MAX);
+    items[n].prb = 106;
+  }
+  sf_quota_counters_snapshot_t c = {UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX};
+  sf_codec_format_counters(items[n].label, sizeof(items[n].label), &c, UINT32_MAX);
+  items[n].prb = 106;
+  return n + 1;
+}
+
+static size_t render_len_unbounded(const sf_readback_item_t *items, size_t n)
+{
+  size_t total = sf_codec_ric_header_len(TSTAMP, (uint32_t)n);
+  for (size_t i = 0; i < n; i++)
+    total += sf_codec_ric_slice_len((uint32_t)i, (uint32_t)i, items[i].label, "SF", items[i].prb ? items[i].prb - 1U : 0U);
+  return total;
+}
+
+static void test_worst_case_fits_real_ric_renderer(void)
+{
+  sf_readback_item_t items[40];
+  const size_t n_items = worst_case_items(items);
+  /* the unbounded composition is what crashed the RIC */
+  CHECK(render_len_unbounded(items, n_items) > 2048);
+
+  slice_ind_msg_t msg = {0};
+  const uint32_t n = sf_readback_pack(&msg, items, n_items, TSTAMP, SF_CODEC_RIC_STRING_BUDGET);
+  CHECK(n >= 2);
+  CHECK(strncmp(msg.slice_conf.dl.slices[0].label, "sf=0.1;kind=outcome", 19) == 0);
+
+  /* decoded labels are NUL terminated by the RIC; mimic that before rendering */
+  for (uint32_t i = 0; i < n; i++) {
+    fr_slice_t *s = &msg.slice_conf.dl.slices[i];
+    s->label = realloc(s->label, s->len_label + 1);
+    s->label[s->len_label] = '\0';
+    s->sched = realloc(s->sched, s->len_sched + 1);
+    s->sched[s->len_sched] = '\0';
+  }
+  char out[2048] = {0};
+  to_string_slice(&msg, msg.tstamp, out, sizeof(out));
+  /* our size model must equal the real rendering, byte for byte */
+  size_t expected = sf_codec_ric_header_len(TSTAMP, n);
+  for (uint32_t i = 0; i < n; i++)
+    expected += sf_codec_ric_slice_len(i, i, msg.slice_conf.dl.slices[i].label, "SF", msg.slice_conf.dl.slices[i].params.u.sta.pos_high);
+  CHECK(strlen(out) == expected);
+  CHECK(strlen(out) <= SF_CODEC_RIC_STRING_BUDGET);
+  /* xApp SQLite constraint: rows before the last one fit the SQL budget */
+  CHECK(n <= SF_READBACK_MAX_SLICES);
+  size_t sql = 0;
+  for (uint32_t i = 0; i + 1 < n; i++)
+    sql += msg.slice_conf.dl.slices[i].len_label + SF_READBACK_SQL_ROW_OVERHEAD;
+  CHECK(sql <= SF_READBACK_SQL_BUDGET + 1024);
+  free_slice_ind_msg(&msg);
+}
+
+static void test_typical_lab_readback_is_complete(void)
+{
+  sf_readback_item_t items[5];
+  sf_quota_outcome_t o = {.status = SF_QUOTA_APPLIED, .action_id = 1793652000000000000ULL,
+                          .target = {.sst = 1, .sd = 1}, .requested_prb = 52, .applied_prb = 52, .previous_prb = 106,
+                          .rollback_token = 0x1234, .expires_at_ns = 1793652030000000000ULL, .table_version = 12};
+  sf_codec_format_outcome(items[0].label, sizeof(items[0].label), &o, 1793652000001000000ULL);
+  sf_prb_rule_snapshot_t r = {.target = {.sst = 1, .sd = 1}, .prb_quota = 52,
+                              .expires_at_ns = 1793652030000000000ULL, .action_id = 1793652000000000000ULL};
+  sf_codec_format_rule(items[1].label, sizeof(items[1].label), &r, 12);
+  sf_codec_format_ue(items[2].label, sizeof(items[2].label), 0x5f7f, 1, 1, 52, 1793652000000000000ULL);
+  sf_codec_format_ue(items[3].label, sizeof(items[3].label), 0x4601, 0, 0xffffff, 106, 0);
+  sf_quota_counters_snapshot_t c = {123456789, 0, 0, 0, 1234567, 12};
+  sf_codec_format_counters(items[4].label, sizeof(items[4].label), &c, 12);
+  for (int i = 0; i < 5; i++)
+    items[i].prb = 52;
+  slice_ind_msg_t msg = {0};
+  CHECK(sf_readback_pack(&msg, items, 5, TSTAMP, SF_CODEC_RIC_STRING_BUDGET) == 5);
+  free_slice_ind_msg(&msg);
+}
+
+int main(void)
+{
+  test_worst_case_fits_real_ric_renderer();
+  test_typical_lab_readback_is_complete();
+  printf("sf_readback_test: all tests passed\n");
+  return 0;
+}
