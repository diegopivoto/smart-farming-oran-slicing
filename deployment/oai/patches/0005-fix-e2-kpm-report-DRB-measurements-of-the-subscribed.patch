-static uldlcounter_t last_pdcp_sdu_total_bytes[MAX_MOBILES_PER_GNB] = {0};
+/* Values of the previous report, kept per (UE, DRB) instead of per UE index of a subscription: with one S-NSSAI
+   subscription per slice, a UE with PDU sessions in two slices is reported by two subscriptions (one DRB each), and
+   counters indexed by the subscription's UE index would mix their deltas. A new entry starts at the current value, so
+   its first report is 0 instead of the whole history of the DRB. */
+typedef struct {
+  bool used;
+  uint32_t rrc_ue_id;
+  int rb_id;
+  bool pdcp_set, rlc_set, prb_set;
+  uldlcounter_t pdcp_sdu_bytes;
+  uldlcounter_t rlc_pdu_bytes;
+  uldlcounter_t total_prbs;
+  uint64_t prb_aggregate_dl;
+  uint64_t prb_aggregate_ul;
+} drb_counters_t;
+
+static drb_counters_t drb_counters[MAX_MOBILES_PER_GNB * 4];
+
+static drb_counters_t *get_drb_counters(const uint32_t rrc_ue_id, const int rb_id)
+{
+  drb_counters_t *free_slot = NULL;
+  for (size_t i = 0; i < sizeof(drb_counters) / sizeof(drb_counters[0]); i++) {
+    drb_counters_t *c = &drb_counters[i];
+    if (c->used && c->rrc_ue_id == rrc_ue_id && c->rb_id == rb_id)
+      return c;
+    if (!c->used && free_slot == NULL)
+      free_slot = c;
+  }
+  if (free_slot == NULL)  // table full (UEs that left): start over
+    free_slot = memset(drb_counters, 0, sizeof(drb_counters));
+  *free_slot = (drb_counters_t){.used = true, .rrc_ue_id = rrc_ue_id, .rb_id = rb_id};
+  return free_slot;
+}
 
-static nr_pdcp_statistics_t get_pdcp_stats_per_drb(const uint32_t rrc_ue_id, const int rb_id)
+// false when the DRB has no PDCP entity (e.g. its PDU session is being released): the DRB is skipped
+static bool get_pdcp_stats_per_drb(const uint32_t rrc_ue_id, const int rb_id, nr_pdcp_statistics_t *pdcp)
 {
