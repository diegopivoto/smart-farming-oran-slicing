+/*
+ * Smart Farming lab policy (Open5GS has no URSP, so the UE cannot know which
+ * S-NSSAI serves a DNN): return the subscribed slice whose session DNN is
+ * `dnn` and that the UE's gNB supports in its TA, or NULL.
+ */
+ogs_slice_data_t *amf_smartfarm_slice_by_dnn(amf_ue_t *amf_ue, const char *dnn)
+{
+    amf_gnb_t *gnb = NULL;
+    ran_ue_t *ran_ue = NULL;
+    int i, k;
+
+    ogs_assert(amf_ue);
+    ogs_assert(dnn);
+
+    ran_ue = ran_ue_find_by_id(amf_ue->ran_ue_id);
+    if (!ran_ue)
+        return NULL;
+    gnb = amf_gnb_find_by_id(ran_ue->gnb_id);
+    if (!gnb)
+        return NULL;
+
+    for (i = 0; i < amf_ue->num_of_slice && i < OGS_MAX_NUM_OF_SLICE; i++) {
+        ogs_slice_data_t *slice = &amf_ue->slice[i];
+
+        for (k = 0; k < slice->num_of_session && k < OGS_MAX_NUM_OF_SESS; k++) {
+            if (slice->session[k].name &&
+                !ogs_strcasecmp(dnn, slice->session[k].name) &&
+                gnb_ta_is_supported(gnb, &amf_ue->nr_tai.plmn_id,
+                    amf_ue->nr_tai.tac, &slice->s_nssai))
+                return slice;
+        }
+    }
+
+    return NULL;
+}
+
+/* Smart Farming lab policy: add `s_nssai` to the UE's Allowed NSSAI if missing */
+void amf_smartfarm_allow_s_nssai(amf_ue_t *amf_ue, ogs_s_nssai_t *s_nssai)
+{
+    int i, n;
+
+    ogs_assert(amf_ue);
+    ogs_assert(s_nssai);
+
+    n = amf_ue->allowed_nssai.num_of_s_nssai;
+    for (i = 0; i < n; i++) {
+        if (amf_ue->allowed_nssai.s_nssai[i].sst == s_nssai->sst &&
+            amf_ue->allowed_nssai.s_nssai[i].sd.v == s_nssai->sd.v)
+            return;
+    }
+    if (n >= OGS_MAX_NUM_OF_SLICE)
+        return;
+
+    memset(&amf_ue->allowed_nssai.s_nssai[n], 0,
+            sizeof(amf_ue->allowed_nssai.s_nssai[n]));
+    amf_ue->allowed_nssai.s_nssai[n].sst = s_nssai->sst;
+    amf_ue->allowed_nssai.s_nssai[n].sd.v = s_nssai->sd.v;
+    amf_ue->allowed_nssai.s_nssai[n].mapped_hplmn_sd.v = OGS_S_NSSAI_NO_SD_VALUE;
+    amf_ue->allowed_nssai.num_of_s_nssai++;
+}
