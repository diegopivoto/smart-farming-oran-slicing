@@ -0,0 +1,25 @@
+/*
+ * Nchf_ConvergedCharging consumer of the SMF (CTF role, TS 32.290/32.291).
+ * Smart Farming DLT slice market: the CHF is discovered through the NRF
+ * (target-nf-type=CHF). Online charging is enforced when a CHF is registered:
+ * a PDU session is only established after the CHF grants a quota.
+ */
+#ifndef SMF_NCHF_CLIENT_H
+#define SMF_NCHF_CLIENT_H
+
+#include "context.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* true: quota granted (or no CHF registered); false: CHF denied the session */
+bool smf_nchf_charging_create(smf_sess_t *sess);
+/* closes the charging session (CDR) of a released PDU session, if any */
+void smf_nchf_charging_release(smf_sess_t *sess);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
