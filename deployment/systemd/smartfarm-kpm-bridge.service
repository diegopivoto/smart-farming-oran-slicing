[Unit]
Description=Smart Farming read-only FlexRIC KPM JSONL bridge
Documentation=file:/usr/local/share/doc/smartfarm/flexric-oai-kpm.md
Requires=smartfarm-flexric.service
After=smartfarm-flexric.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=inatel-crr
Group=inatel-crr
UMask=0027
Environment=SMARTFARM_E2_DISCOVERY_TIMEOUT_S=1800
ExecStart=/usr/local/libexec/smartfarm/smartfarm_kpm_bridge -c /usr/local/etc/flexric/flexric.conf -p /usr/local/lib/flexric/
KillSignal=SIGINT
TimeoutStopSec=20s
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartfarm-kpm-bridge

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
SystemCallArchitectures=native
RemoveIPC=true

[Install]
WantedBy=multi-user.target
